PGHOST=localhost
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD=
PORT=5000

# Optional. If set, used instead of the PG* fields above (DigitalOcean injects this).
DATABASE_URL=

# Local Postgres does not need SSL. App Platform sets PGSSLMODE=require.
PGSSLMODE=
CA_CERT=

# Comma-separated frontend origins. Empty = allow all (local dev).
# Example: https://client.ondigitalocean.app,https://admin.ondigitalocean.app
CORS_ORIGINS=
