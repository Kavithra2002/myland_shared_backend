PGHOST=localhost
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD=
PORT=5000

# Droplet production (on the server, Postgres is local — no SSL):
# PGDATABASE=myland_db
# PGUSER=myland_user
# PGPASSWORD=your_strong_password
# PORT=5000

# Optional. Leave empty on the Droplet (Nginx serves site + /api on the same host).
DATABASE_URL=
PGSSLMODE=
CA_CERT=
CORS_ORIGINS=
JWT_SECRET=

# Listing approval emails (Gmail: use an App Password, not the account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
ADMIN_APP_URL=http://localhost:5174

# CRM: colleague polls this API with X-API-Key. Optional webhook is POSTed when a new lead is saved.
CRM_API_KEY=
CRM_WEBHOOK_URL=
